<network-security-config>
    <!-- Allow cleartext(i.e HTTP) traffic ONLY for local development environments.
     When building a production application you should avoid cleartext permissions and
     ensure to use secure HTTPS (https://).
     -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>